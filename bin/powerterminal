#!/usr/bin/env bash
# powerterminal — replicador de ambiente (Neovim/AstroNvim/Zsh/Kitty/helpers) para Ubuntu/Debian/Pop!_OS.
set -euo pipefail

# Estado interno entre funções e subshells; herdado do ambiente, desviaria os
# recibos, os eventos e a purga de dados de uma execução real.
unset PN_RECEIPT_DIR PN_RECEIPT_MODULE PN_EVENT_MODULE PN_EVENTS_FD PN_PURGE_DATA

POWERTERMINAL_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export POWERTERMINAL_HOME="$POWERTERMINAL_ROOT"

# shellcheck source=/dev/null
source "$POWERTERMINAL_ROOT/lib/core.sh"
# shellcheck source=/dev/null
source "$POWERTERMINAL_ROOT/lib/ui.sh"
# shellcheck source=/dev/null
source "$POWERTERMINAL_ROOT/lib/receipt.sh"
# shellcheck source=/dev/null
source "$POWERTERMINAL_ROOT/lib/events.sh"
# shellcheck source=/dev/null
source "$POWERTERMINAL_ROOT/lib/precheck.sh"

for m in "$POWERTERMINAL_ROOT"/lib/modules/*.sh; do
  # shellcheck source=/dev/null
  source "$m"
done

# Único trap EXIT do programa: limpa keepalive de sudo + arquivo de notas.
trap pn_cleanup EXIT

# Lista canônica e ordenada
_PN_ALL_MODULES=(apt fonts zsh nvim astronvim vscode kitty eza starship lazygit lazydocker uv yazi node claude helpers extras notiont container theme)

# _vf_module_aliases NOME — módulos de um apelido (um por linha); falha se NOME não é apelido.
_vf_module_aliases() {
  case "$1" in
    tools) printf '%s\n' eza starship lazygit lazydocker uv yazi ;;
    *) return 1 ;;
  esac
}

# _vf_expand_aliases CSV — lista CSV com os apelidos trocados pelos módulos, um por linha, sem repetir.
_vf_expand_aliases() {
  local -a itens=()
  local -A visto=()
  local m x
  IFS=',' read -ra itens <<< "$1"
  for m in "${itens[@]}"; do
    if _vf_module_aliases "$m" >/dev/null; then
      while IFS= read -r x; do
        [[ -n "${visto[$x]:-}" ]] || { visto[$x]=1; echo "$x"; }
      done < <(_vf_module_aliases "$m")
    elif [[ -z "${visto[$m]:-}" ]]; then
      visto[$m]=1; echo "$m"
    fi
  done
}

_vf_editor_modules() {
  case "$1" in
    nvim)   echo "nvim astronvim" ;;
    vscode) echo "vscode" ;;
    both)   echo "nvim astronvim vscode" ;;
    *) return 1 ;;
  esac
}

_vf_is_editor_module() {
  [[ " $(_vf_editor_modules both) " == *" $1 "* ]]
}

# Editor sem perguntar: POWERTERMINAL_EDITOR válida, senão o default do perfil.
_vf_editor_default() {
  local perfil="$1"
  if [[ -n "${POWERTERMINAL_EDITOR:-}" ]]; then
    if _vf_editor_modules "$POWERTERMINAL_EDITOR" >/dev/null; then
      echo "$POWERTERMINAL_EDITOR"
      return 0
    fi
    log_warn "POWERTERMINAL_EDITOR inválido: '$POWERTERMINAL_EDITOR' (use nvim|vscode|both)"
  fi
  if [[ "$perfil" == "full" ]]; then echo both; else echo nvim; fi
}

_vf_perfil_tem_editor() { [[ "$1" == "dev" || "$1" == "full" ]]; }

# _vf_profile_modules PERFIL [EDITOR] — módulos do perfil na ordem canônica.
_vf_profile_modules() {
  local perfil="$1" editor="${2:-}" m
  local -A quer=()
  case "$perfil" in
    minimal) echo "apt fonts zsh helpers"; return 0 ;;
    dev)
      for m in apt fonts zsh kitty eza starship lazygit lazydocker uv yazi node claude helpers container theme; do quer[$m]=1; done ;;
    full)
      for m in "${_PN_ALL_MODULES[@]}"; do
        _vf_is_editor_module "$m" || quer[$m]=1
      done ;;
    *) return 1 ;;
  esac
  [[ -n "$editor" ]] || editor="$(_vf_editor_default "$perfil")"
  for m in $(_vf_editor_modules "$editor"); do quer[$m]=1; done

  local out=()
  for m in "${_PN_ALL_MODULES[@]}"; do
    [[ -n "${quer[$m]:-}" ]] && out+=("$m")
  done
  echo "${out[*]}"
}

_vf_module_pairs() {
  local out=()
  for m in "${_PN_ALL_MODULES[@]}"; do
    out+=("$m:$("mod_${m}_meta")")
  done
  printf '%s\n' "${out[@]}"
}

# Itera os links de TODOS os módulos que expõem mod_X_links
_vf_iter_all_links() {
  for m in "${_PN_ALL_MODULES[@]}"; do
    if declare -F "mod_${m}_links" >/dev/null; then
      "mod_${m}_links"
    fi
  done
}

_vf_is_registered() {
  local alvo="$1" m
  for m in "${_PN_ALL_MODULES[@]}"; do
    [[ "$m" == "$alvo" ]] && return 0
  done
  return 1
}

# _vf_precisa_sudo MÓDULOS… — sucesso se algum deles declarar sudo no cost ou se
# houver pré-requisito ausente (o apt dos requisitos também é root).
_vf_precisa_sudo() {
  local m sudo
  [[ -n "$(pn_missing_requires "$@")" ]] && return 0
  for m in "$@"; do
    declare -F "mod_${m}_cost" >/dev/null || continue
    sudo="$("mod_${m}_cost" | cut -f3)"
    [[ "$sudo" == "1" ]] && return 0
  done
  return 1
}

_vf_run_modules() {
  local action="$1" m i=0 total rc
  shift
  total=$#
  for m in "$@"; do
    i=$((i + 1))
    log_section "[$m] $("mod_${m}_meta")"
    pn_event module_begin "module=$m" "action=$action" "index=$i" "total=$total"
    rc=0
    (
      PN_RECEIPT_MODULE="$m"; PN_EVENT_MODULE="$m"
      # O update reinstala por cima do que o install já registrou (ou não, se era do
      # usuário): gravar aqui poria no recibo o que o remove não pode apagar.
      if [[ "$action" == update ]]; then PN_RECEIPT_MODULE=""; fi
      "mod_${m}_${action}"
    ) || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      ok+=("$m")
      pn_event module_end "module=$m" "action=$action" ok=true
    else
      log_error "Módulo $m falhou (rc=$rc)."
      failed+=("$m")
      pn_event module_end "module=$m" "action=$action" ok=false
    fi
  done
  pn_event "done" "ok:=$(pn_json_array "${ok[@]+"${ok[@]}"}")" "failed:=$(pn_json_array "${failed[@]+"${failed[@]}"}")"
}

cmd_install() {
  local profile="" modules_csv="" yes=0 wizard=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile) profile="${2:?--profile requer um valor}"; shift 2 ;;
      --module|--modules) modules_csv="${2:?--module requer lista CSV}"; shift 2 ;;
      --all) profile="full"; shift ;;
      --yes|-y) yes=1; POWERTERMINAL_NONINTERACTIVE=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --events-fd) pn_events_open "${2:?--events-fd requer um número}"; shift 2 ;;
      -h|--help) cmd_help install; return 0 ;;
      *) die "Flag desconhecida: $1 (rode 'powerterminal help install')" ;;
    esac
  done

  [[ -n "$profile" && -n "$modules_csv" ]] \
    && die "--profile e --module são mutuamente exclusivos."

  require_not_root
  require_supported_distro
  pn_receipts_migrate

  local modules=()
  if [[ -n "$profile" ]]; then
    # shellcheck disable=SC2207
    modules=( $(_vf_profile_modules "$profile" || die "Profile inválido: $profile (use minimal|dev|full)") )
  elif [[ -n "$modules_csv" ]]; then
    local pedidos=()
    while IFS= read -r m; do pedidos+=("$m"); done < <(_vf_expand_aliases "$modules_csv")
    for m in "${pedidos[@]}"; do
      declare -F "mod_${m}_install" >/dev/null || die "Módulo desconhecido: $m"
      # pn_expand_deps filtra pela ordem canônica: um módulo fora do array
      # sumiria em silêncio e o install terminaria sem fazer nada.
      _vf_is_registered "$m" || die "Módulo '$m' existe em lib/modules/ mas não está em _PN_ALL_MODULES — registre-o lá."
    done
    modules=()
    while IFS= read -r m; do modules+=("$m"); done < <(pn_expand_deps "${pedidos[@]}")
  else
    ui_welcome

    local perfil
    perfil="$(ui_choose "Como quer configurar?" \
      dev:"ambiente completo de desenvolvimento" \
      minimal:"só o shell (apt, fontes, zsh, helpers)" \
      full:"dev + extras (btop, ranger, picom…)" \
      custom:"escolher módulo a módulo")"

    local pedidos=()
    if [[ "$perfil" == "custom" ]]; then
      local pairs=()
      while IFS= read -r line; do pairs+=("$line"); done < <(_vf_module_pairs)
      while IFS= read -r m; do pedidos+=("$m"); done < <(ui_select_modules "${pairs[@]}")
      [[ ${#pedidos[@]} -gt 0 ]] || die "Nenhum módulo selecionado."
    else
      local editor=""
      if _vf_perfil_tem_editor "$perfil" && [[ -z "${POWERTERMINAL_EDITOR:-}" ]]; then
        editor="$(ui_choose "Qual editor?" \
          nvim:"Neovim + AstroNvim (config versionada)" \
          vscode:"Visual Studio Code (só o editor)" \
          both:"os dois")"
      fi
      # shellcheck disable=SC2207
      pedidos=( $(_vf_profile_modules "$perfil" "$editor") )
      profile="$perfil"
    fi

    modules=()
    while IFS= read -r m; do modules+=("$m"); done < <(pn_expand_deps "${pedidos[@]}")
    wizard=1
  fi

  for m in "${modules[@]}"; do
    declare -F "mod_${m}_install" >/dev/null || die "Módulo desconhecido: $m"
  done

  local faltam
  faltam="$(pn_missing_requires_cmds "${modules[@]}")"

  if [[ "$wizard" -eq 1 ]]; then
    # Todas as perguntas dos módulos acontecem aqui, antes de qualquer mudança —
    # o usuário responde tudo de uma vez em vez de ser interrompido no meio.
    for m in "${modules[@]}"; do
      declare -F "mod_${m}_configure" >/dev/null && "mod_${m}_configure"
    done
    ui_summary "${modules[@]}"
  else
    log_info "Profile: ${profile:-custom}"
    log_info "Módulos: ${modules[*]}"
    [[ -n "$faltam" ]] && log_info "Pré-requisitos ausentes: $faltam (instalados via apt antes dos módulos)"
  fi
  [[ "$DRY_RUN" == "1" ]] && log_warn "DRY-RUN ativo — nenhuma mudança real será feita."

  if [[ "$yes" -eq 0 ]]; then
    ui_confirm "Instalar agora?" || { log_info "Cancelado."; exit 0; }
  fi

  # Sudo uma vez só, aqui: antes dos módulos e depois da confirmação, para que a
  # senha não apareça no meio de um processo de minutos. Só pedimos se algum
  # módulo escolhido declarar que precisa: o launcher só libera o sudo nesse caso.
  if { [[ "$yes" -eq 1 ]] || [[ "$wizard" -eq 1 ]]; } && _vf_precisa_sudo "${modules[@]}"; then
    setup_sudo_keepalive
  fi

  local failed=() ok=() t0 dt
  if [[ "$wizard" -eq 1 ]]; then
    # Resolve o log antes do laço e sem $(...): a global precisa ser populada no
    # processo pai, senão cada $(pn_log_file) recalcula o timestamp e a execução
    # se espalha por vários arquivos.
    _pn_resolve_log_file
    [[ "$DRY_RUN" == "1" ]] || log_info "Log completo: $(pn_log_file)"
    # Requisitos antes do primeiro módulo; se falhar, segue — quem depender
    # deles falha isolado no próprio passo, como qualquer módulo.
    if [[ -n "$faltam" ]]; then
      ui_step_begin "requisitos"
      t0="$(date +%s)"
      if ( pn_install_requires "${modules[@]}" ) >>"$(pn_log_file)" 2>&1; then
        ui_step_ok "requisitos" "$(( $(date +%s) - t0 ))"
      else
        ui_step_fail "requisitos"
      fi
    fi
    for m in "${modules[@]}"; do
      ui_step_begin "$m"
      t0="$(date +%s)"
      if ( PN_RECEIPT_MODULE="$m"; PN_EVENT_MODULE="$m"; "mod_${m}_install" ) >>"$(pn_log_file)" 2>&1; then
        dt=$(( $(date +%s) - t0 ))
        ui_step_ok "$m" "$dt"
        ok+=("$m")
      else
        ui_step_fail "$m"
        failed+=("$m")
      fi
    done
    ui_final "${ok[*]:-}" "${failed[*]:-}"
  else
    if [[ -n "$faltam" ]]; then
      log_section "[requisitos] Ferramentas que os módulos escolhidos invocam"
      ( pn_install_requires "${modules[@]}" ) \
        || log_warn "Não consegui instalar os pré-requisitos ($faltam) — os módulos que dependem deles vão falhar."
    fi
    _vf_run_modules install "${modules[@]}"
    print_post_install_notes
  fi

  if [[ ${#failed[@]} -gt 0 ]]; then
    [[ "$wizard" -eq 0 ]] && log_warn "Módulos com falha: ${failed[*]}"
    exit 1
  fi

  if [[ "$wizard" -eq 0 ]]; then
    log_success "Instalação concluída."
    log_info "Próximos passos:"
    log_info "  1) abra um novo terminal (zsh) ou rode: exec zsh"
    log_info "  2) rode 'nvim' uma vez para o Lazy.nvim instalar os plugins"
    log_info "  3) verifique tudo com: powerterminal doctor"
  fi
}

_vf_remove_precisa_sudo() {
  local m tipo valor
  for m in "$@"; do
    while IFS=$'\t' read -r tipo valor; do
      case "$tipo" in
        apt|apt_repo|login_shell|group|subids) return 0 ;;
        dir|file) [[ "$valor" == "$HOME"/?* ]] || return 0 ;;
      esac
    done < <(pn_receipt_entries "$m")
  done
  return 1
}

# _vf_dependentes ALVO REMOVIDOS… — módulos presentes (com recibo ou detectados)
# que declaram ALVO em mod_X_needs, fora os que saem no mesmo comando.
_vf_dependentes() {
  local alvo="$1" o deps=""
  shift
  for o in "${_PN_ALL_MODULES[@]}"; do
    [[ " $* " == *" $o "* ]] && continue
    declare -F "mod_${o}_needs" >/dev/null || continue
    [[ $'\n'"$("mod_${o}_needs")"$'\n' == *$'\n'"$alvo"$'\n'* ]] || continue
    if pn_receipt_has "$o" || { declare -F "mod_${o}_installed" >/dev/null && "mod_${o}_installed"; }; then
      deps+="${deps:+, }$o"
    fi
  done
  printf '%s' "$deps"
}

# Migra numa cópia temporária: o dry-run mostra a migração pendente sem gravar no estado real.
_vf_remove_preview_receipts() {
  local real tmp
  real="$(pn_receipt_dir)"
  tmp="$(mktemp -d -t powerterminal-preview.XXXXXX)"
  pn_register_cleanup_dir "$tmp"
  mkdir -p "$tmp/receipts"
  if [[ -d "$real" ]]; then cp -a "$real/." "$tmp/receipts/"; fi
  PN_RECEIPT_DIR="$tmp/receipts"
  DRY_RUN=0 pn_receipts_migrate
}

cmd_remove() {
  local modules_csv="" yes=0 purge=0 m i deps lista=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --module|--modules) modules_csv="${2:?--module requer lista CSV}"; shift 2 ;;
      --yes|-y) yes=1; POWERTERMINAL_NONINTERACTIVE=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --purge-data) purge=1; shift ;;
      --events-fd) pn_events_open "${2:?--events-fd requer um número}"; shift 2 ;;
      -h|--help) cmd_help remove; return 0 ;;
      *) die "Flag desconhecida: $1 (rode 'powerterminal help remove')" ;;
    esac
  done
  [[ -n "$modules_csv" ]] || die "remove exige --module a,b (rode 'powerterminal help remove')."

  local -a pedidos=() alvos=()
  local -A pedido=()
  while IFS= read -r m; do pedidos+=("$m"); done < <(_vf_expand_aliases "$modules_csv")
  for m in "${pedidos[@]}"; do
    _vf_is_registered "$m" || die "Módulo desconhecido: $m"
    declare -F "mod_${m}_remove" >/dev/null || die "O módulo $m não pode ser removido."
    pedido[$m]=1
  done
  if [[ "$purge" -eq 1 && -z "${pedido[container]:-}" ]]; then
    die "--purge-data só vale com --module container."
  fi

  require_not_root
  require_supported_distro
  if [[ "$DRY_RUN" == "1" ]]; then
    _vf_remove_preview_receipts
  else
    pn_receipts_migrate
  fi

  for (( i = ${#_PN_ALL_MODULES[@]} - 1; i >= 0; i-- )); do
    m="${_PN_ALL_MODULES[i]}"
    if [[ -n "${pedido[$m]:-}" ]]; then alvos+=("$m"); fi
  done

  log_info "Remover: ${alvos[*]}"
  for m in "${alvos[@]}"; do
    [[ "$(pn_receipt_origin "$m")" == deduced ]] \
      && log_warn "O recibo de $m foi deduzido de uma instalação anterior aos recibos — confira com --dry-run o que sai."
    deps="$(_vf_dependentes "$m" "${alvos[@]}")"
    [[ -n "$deps" ]] && log_warn "$deps dependem de $m e vão parar de funcionar."
    lista+="${lista:+, }$m"
  done
  [[ "$purge" -eq 1 ]] && log_warn "--purge-data: imagens, containers e volumes do runtime também serão apagados."
  [[ "$DRY_RUN" == "1" ]] && log_warn "DRY-RUN ativo — nada será apagado."

  if [[ "$yes" -eq 0 ]]; then
    ui_confirm "Remover $lista?" || { log_info "Cancelado."; exit 0; }
    # Só o --yes deste comando pula esta pergunta: um POWERTERMINAL_NONINTERACTIVE
    # herdado do ambiente não pode apagar dados sem ninguém confirmar.
    if [[ "$purge" -eq 1 ]]; then
      POWERTERMINAL_NONINTERACTIVE=0 ui_confirm "Apagar imagens, containers e volumes? Não dá para desfazer." \
        || { log_info "Cancelado."; exit 0; }
    fi
  fi
  [[ "$purge" -eq 1 ]] && export PN_PURGE_DATA=1

  if [[ "$DRY_RUN" != "1" ]] && _vf_remove_precisa_sudo "${alvos[@]}"; then
    setup_sudo_keepalive
  fi

  local ok=() failed=()
  _vf_run_modules remove "${alvos[@]}"
  print_post_install_notes

  if [[ ${#failed[@]} -gt 0 ]]; then
    log_warn "Módulos com falha: ${failed[*]} (o que não saiu continua no recibo)"
    exit 1
  fi
  log_success "Remoção concluída."
}

cmd_link() {
  local dry=0
  for a in "$@"; do [[ "$a" == "--dry-run" ]] && dry=1; done
  [[ "$dry" == "1" ]] && DRY_RUN=1
  log_section "Refazendo symlinks (sem reinstalar nada)"
  ensure_local_bin
  while IFS=$'\t' read -r src dst; do
    [[ -z "$src" ]] && continue
    [[ -e "$src" ]] || { log_warn "Source ausente, pulando: $src"; continue; }
    link_safe "$src" "$dst"
  done < <(_vf_iter_all_links)
  log_success "Symlinks atualizados."
}

cmd_unlink() {
  local dry=0
  for a in "$@"; do [[ "$a" == "--dry-run" ]] && dry=1; done
  [[ "$dry" == "1" ]] && DRY_RUN=1
  log_section "Removendo symlinks do PowerTerminal (e restaurando backups quando houver)"
  while IFS=$'\t' read -r _src dst; do
    [[ -z "$dst" ]] && continue
    unlink_safe "$dst"
  done < <(_vf_iter_all_links)
  log_success "Unlink concluído."
}

cmd_status() {
  log_section "Status do PowerTerminal"
  printf "  Repo: %s\n" "$POWERTERMINAL_HOME"
  printf "  Versão: %s\n" "$(cat "$POWERTERMINAL_HOME/VERSION" 2>/dev/null || echo '?')"
  printf "  Distro: %s\n" "$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-?}")"
  printf "  Shell: %s\n" "${SHELL:-?}"
  echo ""
  echo "  Symlinks gerenciados:"
  while IFS=$'\t' read -r _src dst; do
    [[ -z "$dst" ]] && continue
    if [[ -L "$dst" ]]; then
      printf "    %s✓%s %s → %s\n" "$C_GREEN" "$C_R" "$dst" "$(readlink "$dst")"
    elif [[ -e "$dst" ]]; then
      printf "    %s•%s %s (existe, NÃO é symlink)\n" "$C_YELLOW" "$C_R" "$dst"
    else
      printf "    %s✗%s %s (ausente)\n" "$C_RED" "$C_R" "$dst"
    fi
  done < <(_vf_iter_all_links)
}

cmd_doctor() {
  log_section "Diagnóstico"
  is_supported_distro && status_line 1 "Distro suportada" || status_line 0 "Distro não suportada"
  pn_requires_doctor "${_PN_ALL_MODULES[@]}"
  for m in "${_PN_ALL_MODULES[@]}"; do
    "mod_${m}_doctor"
  done
}

cmd_share() {
  local outfile=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      -*) die "Flag desconhecida: $1 (rode 'powerterminal help share')" ;;
      *)
        [[ -z "$outfile" ]] || die "share aceita no máximo um argumento (arquivo de saída)."
        outfile="$1"; shift ;;
    esac
  done
  outfile="${outfile:-powerterminal-share-$(date +%Y%m%d).tar.gz}"
  log_section "Empacotando PowerTerminal para compartilhamento"
  log_info "Saída: $outfile"
  if [[ "$DRY_RUN" == "1" ]]; then
    log_dry "tar -czf $outfile (excluindo home.local, .pnbak.*, .pnnew, .git)"
    return 0
  fi
  # Importante: --exclude usa wildcards relativos ao caminho dentro do tar.
  # *.pnbak.* casa em qualquer profundidade; o nome do diretório raiz não.
  tar -czf "$outfile" \
    -C "$(dirname "$POWERTERMINAL_HOME")" \
    --exclude='*.pnbak.*' \
    --exclude='*.pnnew' \
    --exclude='home.local' \
    --exclude='.git' \
    "$(basename "$POWERTERMINAL_HOME")"
  log_success "Pacote criado: $outfile"
  log_info "Para o colega usar:"
  log_info "  tar -xzf $(basename "$outfile") -C \$HOME && \$HOME/PowerTerminal/bin/powerterminal install"
}

cmd_theme() {
  local flavor="" acao="aplicar"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      status) acao="status"; shift ;;
      -*) die "Flag desconhecida: $1 (rode 'powerterminal help theme')" ;;
      *)
        [[ -z "$flavor" ]] || die "theme aceita no máximo um flavor (rode 'powerterminal help theme')."
        flavor="$1"; shift ;;
    esac
  done

  log_section "Tema"
  if [[ "$acao" == "status" ]]; then
    mod_theme_doctor
    return 0
  fi

  if [[ -z "$flavor" ]]; then
    flavor="$(ui_choose "Qual flavor Catppuccin?" \
      "mocha:escuro (default do PowerTerminal)" \
      "macchiato:escuro, contraste médio" \
      "frappe:escuro suave" \
      "latte:claro")"
  fi

  _vf_theme_apply "$flavor"
  _vf_theme_reload_kitty
  log_info "Neovim e prompt: o flavor é lido no startup, então valem em sessão nova."
}

cmd_update() {
  local modules_csv="" m
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --module|--modules) modules_csv="${2:?--module requer lista CSV}"; shift 2 ;;
      --yes|-y) POWERTERMINAL_NONINTERACTIVE=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --events-fd) pn_events_open "${2:?--events-fd requer um número}"; shift 2 ;;
      -h|--help) cmd_help update; return 0 ;;
      *) die "Flag desconhecida: $1 (rode 'powerterminal help update')" ;;
    esac
  done

  local -a pedidos=() alvos=()
  local -A pedido=()
  if [[ -n "$modules_csv" ]]; then
    while IFS= read -r m; do pedidos+=("$m"); done < <(_vf_expand_aliases "$modules_csv")
    for m in "${pedidos[@]}"; do
      _vf_is_registered "$m" || die "Módulo desconhecido: $m"
      declare -F "mod_${m}_update" >/dev/null \
        || die "O módulo $m não tem atualização própria; ele muda junto com a release do PowerTerminal."
      pedido[$m]=1
    done
  fi

  require_not_root
  require_supported_distro

  for m in "${_PN_ALL_MODULES[@]}"; do
    declare -F "mod_${m}_update" >/dev/null || continue
    [[ -z "$modules_csv" || -n "${pedido[$m]:-}" ]] || continue
    if pn_receipt_has "$m" || "mod_${m}_installed"; then
      alvos+=("$m")
    elif [[ -n "$modules_csv" ]]; then
      log_info "$m não está instalado — o update não instala; use 'powerterminal install --module $m'."
    fi
  done

  if [[ ${#alvos[@]} -eq 0 ]]; then
    log_info "Nenhum módulo instalado tem atualização própria."
    return 0
  fi

  log_info "Atualizar: ${alvos[*]}"
  [[ "$DRY_RUN" == "1" ]] && log_warn "DRY-RUN ativo — nada será alterado."

  if [[ "$DRY_RUN" != "1" ]]; then
    local sudo
    for m in "${alvos[@]}"; do
      declare -F "mod_${m}_cost" >/dev/null || continue
      sudo="$("mod_${m}_cost" | cut -f3)"
      if [[ "$sudo" == "1" ]]; then setup_sudo_keepalive; break; fi
    done
  fi

  local ok=() failed=()
  _vf_run_modules update "${alvos[@]}"
  print_post_install_notes

  if [[ ${#failed[@]} -gt 0 ]]; then
    log_warn "Módulos com falha: ${failed[*]}"
    exit 1
  fi
  if has_cmd nvim && [[ -d "$HOME/.config/nvim" ]]; then
    log_info "Para atualizar plugins do Neovim: nvim '+Lazy sync' '+qa'"
  fi
  log_success "Update concluído."
}

_vf_catalog_distro() {
  local nome
  nome="$( . /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-}" )" || nome=""
  if [[ -n "$nome" ]]; then pn_json_str "$nome"; else printf 'null'; fi
}

_vf_catalog_module() {
  local m="$1" f meta cost minutos=0 mb=0 sudo=false state origin dados editor=false upd=false rem=false
  local -a needs=()
  local nome categoria
  for f in meta name category installed; do
    declare -F "mod_${m}_${f}" >/dev/null || die "Módulo $m sem a função mod_${m}_${f}."
  done
  meta="$(mod_"${m}"_meta)"
  nome="$(mod_"${m}"_name)"
  categoria="$(mod_"${m}"_category)"
  if declare -F "mod_${m}_cost" >/dev/null; then
    cost="$(mod_"${m}"_cost)"
    IFS=$'\t' read -r minutos mb dados <<<"$cost"
    [[ "$minutos" =~ ^[0-9]+$ ]] || minutos=0
    [[ "$mb" =~ ^[0-9]+$ ]] || mb=0
    [[ "$dados" == 1 ]] && sudo=true
  fi
  # Pré-requisito ausente também é apt (root): mesma regra do _vf_precisa_sudo,
  # que o launcher só consegue seguir por este campo.
  [[ "$sudo" == false && -n "$(pn_missing_requires "$m")" ]] && sudo=true
  if declare -F "mod_${m}_needs" >/dev/null; then
    mapfile -t needs < <(mod_"${m}"_needs)
  fi
  if pn_receipt_has "$m"; then
    state=installed; origin="$(pn_receipt_origin "$m")"
  elif mod_"${m}"_installed; then
    state=preexisting; origin=""
  else
    state=available; origin=""
  fi
  if [[ -n "$origin" ]]; then origin="$(pn_json_str "$origin")"; else origin=null; fi
  dados=null
  if declare -F "mod_${m}_data_mb" >/dev/null; then
    dados="$(mod_"${m}"_data_mb)"
    [[ "$dados" =~ ^[0-9]+$ ]] || dados=null
  fi
  _vf_is_editor_module "$m" && editor=true
  declare -F "mod_${m}_update" >/dev/null && upd=true
  declare -F "mod_${m}_remove" >/dev/null && rem=true
  printf '{"id":%s,"name":%s,"category":%s,"description":%s,"minutes":%s,"mb":%s,"sudo":%s,"needs":%s,"editor":%s,"state":"%s","origin":%s,"can_update":%s,"can_remove":%s,"data_mb":%s}' \
    "$(pn_json_str "$m")" "$(pn_json_str "$nome")" "$(pn_json_str "$categoria")" \
    "$(pn_json_str "$meta")" "$minutos" "$mb" "$sudo" "$(pn_json_array "${needs[@]}")" \
    "$editor" "$state" "$origin" "$upd" "$rem" "$dados"
}

cmd_catalog() {
  [[ "${1:-}" == "--json" ]] || die "catalog exige --json (saída legível por máquina)."
  [[ $# -eq 1 ]] || die "catalog não aceita outros argumentos: ${*:2}"
  declare -F pn_receipts_migrate >/dev/null && pn_receipts_migrate >&2
  local m perfil sep="" mods="" perfis="" ed version="" lista entrada
  local -a itens
  for perfil in minimal dev full; do
    ed=""; [[ "$perfil" == minimal ]] || ed=both
    lista="$(_vf_profile_modules "$perfil" $ed)" || exit 1
    read -r -a itens <<<"$lista"
    perfis+="${perfis:+,}\"$perfil\":$(pn_json_array "${itens[@]}")"
  done
  for m in "${_PN_ALL_MODULES[@]}"; do
    entrada="$(_vf_catalog_module "$m")" || exit 1
    mods+="${sep}${entrada}"; sep=","
  done
  [[ -r "$POWERTERMINAL_ROOT/VERSION" ]] && version="$(tr -d '[:space:]' <"$POWERTERMINAL_ROOT/VERSION")"
  printf '{"contract_version":1,"version":%s,"distro":%s,"arch":%s,"profiles":{%s},"modules":[%s]}\n' \
    "$(pn_json_str "$version")" "$(_vf_catalog_distro)" "$(pn_json_str "$(uname -m)")" "$perfis" "$mods"
}

cmd_help() {
  local topic="${1:-}"
  if [[ -z "$topic" || "$topic" == "main" ]]; then
    cat <<EOF
${C_PURPLE}${C_B}PowerTerminal${C_R} — replicador de ambiente Neovim/AstroNvim/Zsh/Kitty/helpers

${C_B}Uso:${C_R}
  powerterminal <comando> [opções]

${C_B}Comandos:${C_R}
  install   instala módulos selecionados (TUI por default)
  link      refaz apenas os symlinks (sem reinstalar nada)
  unlink    remove os symlinks gerenciados (restaura backups)
  remove    desfaz módulos instalados (remove --module a,b)
  status    mostra o estado atual dos symlinks
  doctor    diagnostica todos os módulos
  catalog   lista módulos e estado em JSON (catalog --json)
  theme     troca o flavor Catppuccin (kitty + Neovim + prompt)
  share     empacota o repo num .tar.gz para compartilhar com colegas
  update    atualiza módulos instalados (update --module a,b)
  help      ajuda (use 'help <comando>' para detalhes)

${C_B}Profiles:${C_R}
  minimal   apt + fonts + zsh + helpers
  dev       minimal + editor + kitty + tools + node + claude + container + theme
  full      tudo (= dev + extras + notiont), com os dois editores

  editor = nvim + astronvim, vscode ou ambos: o assistente pergunta;
  fora dele vale POWERTERMINAL_EDITOR=nvim|vscode|both (default: dev → nvim,
  full → both). Para acrescentar depois: install --module vscode

${C_B}Exemplos:${C_R}
  powerterminal install                            # menu interativo
  powerterminal install --profile full --yes       # tudo, sem perguntas
  powerterminal install --module zsh,fonts,helpers # só esses módulos
  powerterminal install --profile dev --dry-run    # simula sem mudar nada
  powerterminal theme latte                        # tema claro em tudo
  powerterminal share dotfiles-2026-05.tar.gz      # gera pacote compartilhável
EOF
    return 0
  fi
  case "$topic" in
    install)
      cat <<EOF
${C_B}powerterminal install${C_R} [--profile P | --module a,b,c] [--yes] [--dry-run]

  --profile <minimal|dev|full>   conjunto pré-definido de módulos
  --module a,b,c                 lista CSV (mutuamente exclusivo com --profile)
  --all                          equivale a --profile full
  --yes / -y                     não pedir confirmação (pede sudo upfront se precisar)
  --dry-run                      simula (logs em cinza, nada é executado)

  POWERTERMINAL_EDITOR=nvim|vscode|both   editor dos perfis dev/full sem perguntar

Módulos disponíveis: ${_PN_ALL_MODULES[*]}
EOF
      ;;
    theme)
      cat <<EOF
${C_B}powerterminal theme${C_R} [flavor | status] [--dry-run]

  (sem argumento)   menu para escolher o flavor
  latte             claro
  frappe            escuro suave
  macchiato         escuro, contraste médio
  mocha             escuro (default do PowerTerminal)
  status            mostra o flavor em vigor e se os consumidores concordam

Aplica em quatro lugares a partir de ~/.config/powerterminal/theme: cores do
kitty (recarregadas nas janelas abertas), colorscheme do Neovim, cores do
prompt e o tema do Claude Code (light no latte, dark nos demais).

Neovim e prompt leem o flavor no startup, então valem em sessão nova. As cores
das abas do kitty exigem uma janela nova.
EOF
      ;;
    remove)
      cat <<EOF
${C_B}powerterminal remove${C_R} --module a,b [--yes] [--dry-run] [--purge-data] [--events-fd N]

  --module a,b       módulos a desfazer (na ordem inversa da instalação)
  --yes / -y         não pedir confirmação (pede sudo upfront se precisar)
  --dry-run          simula: nada é apagado, nem o recibo
  --purge-data       só com container: apaga também imagens, containers e
                     volumes do runtime que o PowerTerminal instalou
                     (confirmação própria, pulada só com --yes)
  --events-fd N      eventos JSON Lines no descritor N

Desfaz só o que o recibo do módulo registra (links, arquivos, pacotes apt,
repositórios, shell de login, grupos…) e restaura os .pnbak mais recentes.
Nada que já existia antes do PowerTerminal é apagado; pacote apt que outro
módulo também instalou fica. O que não puder ser desfeito continua no recibo.
EOF
      ;;
    catalog)
      cat <<EOF
${C_B}powerterminal catalog${C_R} --json

Imprime em stdout um único objeto JSON (contract_version 1) com versão, distro,
arquitetura, módulos de cada perfil e, por módulo, descrição, custo, dependências,
estado (installed|preexisting|available) e ações disponíveis. Logs vão para stderr.
EOF
      ;;
    update)
      cat <<EOF
${C_B}powerterminal update${C_R} [--module a,b] [--yes] [--dry-run] [--events-fd N]

  --module a,b       só estes módulos (padrão: todos os instalados com update próprio)
  --yes / -y         modo não-interativo (o update nunca pergunta confirmação)
  --dry-run          simula: mostra o que seria rodado
  --events-fd N      eventos JSON Lines no descritor N

Módulos com atualização própria: apt, zsh, nvim, vscode, kitty, eza, starship, lazygit,
lazydocker, uv, yazi, node, claude, container, notiont (tools = as seis CLIs). Os demais mudam junto com a release do PowerTerminal.
O update só reinstala o que o recibo diz ser do PowerTerminal e só faz upgrade de
pacote apt já instalado; módulo ausente não é instalado, e o recibo não muda.
EOF
      ;;
    link|unlink|status|doctor|share)
      printf "powerterminal %s — %s\n" "$topic" "Use 'powerterminal $topic --dry-run' (quando aplicável) para simular."
      ;;
    *) die "Tópico de ajuda desconhecido: $topic" ;;
  esac
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    install) cmd_install "$@" ;;
    link)    cmd_link    "$@" ;;
    unlink)  cmd_unlink  "$@" ;;
    remove)  cmd_remove  "$@" ;;
    status)  cmd_status  "$@" ;;
    doctor)  cmd_doctor  "$@" ;;
    catalog) cmd_catalog "$@" ;;
    theme)   cmd_theme   "$@" ;;
    share)   cmd_share   "$@" ;;
    update)  cmd_update  "$@" ;;
    help|-h|--help) cmd_help "${1:-}" ;;
    version|--version|-V) cat "$POWERTERMINAL_ROOT/VERSION" ;;
    *) die "Comando desconhecido: $cmd. Rode 'powerterminal help'." ;;
  esac
}

main "$@"
