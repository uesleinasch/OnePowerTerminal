#!/usr/bin/env bash
set -u
ticket="${FAKE_SUDO_STATE:?}/ticket"

# -p PROMPT antes da ação, como o launcher chama (sudo -p MARCADOR -v).
custom_prompt=''
if [[ ${1:-} == -p ]]; then
  custom_prompt="${2-}"
  shift 2
fi

case "${1:-}" in
  -k)
    rm -f "$ticket"
    exit 0
    ;;
  -n)
    [[ ${2:-} == true && -f $ticket ]]
    exit
    ;;
  -v)
    [[ -f $ticket ]] && exit 0
    if [[ ${FAKE_SUDO_RS:-0} == 1 ]]; then
      # sudo-rs: ignora o SUDO_PROMPT e embrulha o -p.
      prompt="[sudo: ${custom_prompt:-authenticate}] Password: "
    else
      prompt="${custom_prompt:-${SUDO_PROMPT:-[sudo] password: }}"
    fi
    [[ ${FAKE_SUDO_ALT_PROMPT:-0} == 1 ]] && prompt='Verification code: '
    for _ in 1 2 3; do
      printf '%s' "$prompt" >/dev/tty
      IFS= read -r -s pw </dev/tty || exit 1
      printf '\n' >/dev/tty
      if [[ $pw == "${FAKE_SUDO_PASSWORD:-}" ]]; then
        if [[ ${FAKE_SUDO_DENY:-0} == 1 ]]; then
          echo "${USER:-user} is not in the sudoers file." >&2
          exit 1
        fi
        : >"$ticket"
        exit 0
      fi
      echo 'Sorry, try again.' >&2
    done
    echo 'sudo: 3 incorrect password attempts' >&2
    exit 1
    ;;
esac

echo "sudo falso: argumentos não suportados: $*" >&2
exit 1
